{
  "name": "ccna-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "CCNA 200-301 v1.1 practice and exam simulator. Original question bank mapped to official blueprint objectives, with blueprint-weighted exam simulation.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate:bank": "node scripts/validate-bank.mjs",
    "validate:review": "node scripts/validate-review.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:anti-rot": "node scripts/check-anti-rot.mjs",
    "license:check": "node scripts/license-check.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "validate": "npm run lint && npm run test && npm run build && npm run validate:bank && npm run validate:review && npm run validate:docs && npm run validate:anti-rot && npm run license:check"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.5",
    "vitest": "^5.0.3"
  }
}
